# ==============================================================================
# UPSC Prelims & Mains Exam Practice Hub - Environment Configuration Template
# ==============================================================================
# Environment Selection:
# - PROD  : Fetch and sync attempts, drafts, and data with live Production.
# - LOCAL : Isolated local development mode using local disk storage (public/data/).
# ==============================================================================
environment=PROD

# Production API Endpoint (optional, defaults to constant: https://upsc-practice.vercel.app)
PROD_API_URL=https://upsc-practice.vercel.app
